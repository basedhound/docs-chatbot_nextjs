# Copy to .env and fill in. Never commit .env.
# Values for each Vercel environment are set in the Vercel project settings.

# Client + server: Supabase project URL (public by design; RLS is the boundary)
NEXT_PUBLIC_SUPABASE_URL=
# Client + server: Supabase publishable key (public by design; RLS is the boundary)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key (acts as service_role, skips RLS)
SUPABASE_SECRET_KEY=
# Client: Clerk publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only: Clerk secret key
CLERK_SECRET_KEY=
# Server only: OpenAI API key (chat + embeddings)
OPENAI_API_KEY=
# Server only: verifies Clerk webhook signatures
CLERK_WEBHOOK_SIGNING_SECRET=
# Server only: Arcjet key (rate limits, prompt injection checks)
ARCJET_KEY=
# Client + server: PostHog project key
NEXT_PUBLIC_POSTHOG_KEY=
# Client + server: PostHog host
NEXT_PUBLIC_POSTHOG_HOST=
# Client + server: public base URL of this app
NEXT_PUBLIC_APP_URL=
# Server only (read at request time): widget public key for the landing page demo
LANDING_WIDGET_KEY=
